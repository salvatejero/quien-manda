    "Quién Manda" : {
      "shouldTranslate" : false
    },
    "Quién Manda es gratis y lo seguirá siendo. Si te ahorra levantarte del sofá, puedes invitarme a algo. No desbloquea nada." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quién Manda es gratis y lo seguirá siendo. Si te ahorra levantarte del sofá, puedes invitarme a algo. No desbloquea nada."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quién Manda is free and always will be. If it saves you getting up from the couch, you can buy me something. It doesn't unlock anything."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Quién Manda é gratuito e vai continuar a sê-lo. Se te poupa a levantar-te do sofá, podes pagar-me alguma coisa. Não desbloqueia nada."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quién Manda és gratuïta i ho continuarà sent. Si t'estalvia aixecar-te del sofà, em pots convidar a alguna cosa. No desbloqueja res."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quién Manda é de balde e seguirao sendo. Se che aforra levantarte do sofá, podes convidarme a algo. Non desbloquea nada."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quién Manda doakoa da eta hala jarraituko du. Sofatik altxatzea aurrezten badizu, zerbaitetara gonbida nazakezu. Ez du ezer desblokeatzen."
          }
        }
      }
    },
