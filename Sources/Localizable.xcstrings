    "¿No aparece tu tele? Comprueba que está encendida y conectada a la misma red Wi-Fi." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿No aparece tu tele? Comprueba que está encendida y conectada a la misma red Wi-Fi."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't see your TV? Check that it's on and connected to the same Wi-Fi network."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tua TV não aparece? Verifica se está ligada e na mesma rede Wi-Fi."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No apareix la teva tele? Comprova que està encesa i connectada a la mateixa xarxa Wi-Fi."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non aparece a túa tele? Comproba que está acesa e conectada á mesma rede wifi."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez da zure telebista agertzen? Egiaztatu piztuta eta wifi sare berera konektatuta dagoela."
          }
        }
      }
    }
