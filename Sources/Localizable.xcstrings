    "Toca una para conectarte. Desliza a la izquierda para renombrarla u olvidarla." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una para conectarte. Desliza a la izquierda para renombrarla u olvidarla."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap one to connect. Swipe left to rename or forget it."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca numa para te ligares. Desliza para a esquerda para lhe mudar o nome ou a esquecer."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca'n una per connectar-t'hi. Llisca cap a l'esquerra per canviar-li el nom o oblidar-la."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca unha para conectarte. Esvara á esquerda para renomeala ou esquecela."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukitu bat konektatzeko. Pasatu ezkerrera izena aldatzeko edo ahazteko."
          }
        }
      }
    },
